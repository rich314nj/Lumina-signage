#!/bin/bash
# Launches the LuminaShow player full-screen.
#
# In appliance mode this runs inside cage (a Wayland kiosk compositor) from
# lumina-kiosk.service. On a full desktop it is launched by the XDG autostart
# entry instead. Both paths share this script so the browser flags stay in
# one place.
set -u

# Point the browser at the bootstrap page rather than /player directly
# (FIX #29). Nginx serves it from disk, so it loads even when the application
# is still starting or has failed; it then hands over to the player once the
# app answers. Chromium will not recover on its own from an error page, so it
# must never be given the chance to land on one.
BOOTSTRAP_URL="${LUMINA_BOOTSTRAP_URL:-http://localhost/static/kiosk.html}"

# Written by scripts/lumina-display (#17). World-readable, not sensitive -
# never sourced, only ever read through the strict parse below.
DISPLAY_CONF="${LUMINA_DISPLAY_CONF:-/etc/lumina/display.conf}"

# Wait for Nginx to serve the bootstrap page before starting the browser.
# This only needs the web server, not the application, so it clears quickly.
for _ in $(seq 1 150); do
  if curl -sf -o /dev/null --max-time 3 "$BOOTSTRAP_URL"; then
    break
  fi
  sleep 2
done

BROWSER="$(command -v chromium-browser || command -v chromium || true)"
if [ -z "$BROWSER" ]; then
  echo "lumina-kiosk: no chromium binary found" >&2
  exit 1
fi

PROFILE_DIR="${HOME:-/tmp}/.config/lumina-kiosk"
mkdir -p "$PROFILE_DIR"

# Only force the Wayland backend when actually running under a Wayland
# compositor — passing it on an X11 desktop stops Chromium from starting.
PLATFORM_ARGS=()
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  PLATFORM_ARGS+=(--ozone-platform=wayland)
fi

# Screen rotation (#17). Applied here, not from the privileged helper that
# saves it, because only a process inside this Wayland session (inherited
# from cage, our parent) can actually talk to the compositor. Every failure
# path below falls through to starting Chromium unrotated rather than
# blocking it — a rotation that doesn't apply is a much smaller problem
# than a kiosk that never starts.
apply_display_rotation() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 0

  # Strictly the FIRST line only, matching app.py's read_first_line() -
  # both sides must parse this file identically, or GET /api/system/display
  # could report a rotation this script would not actually apply. A stray
  # ROTATION= appearing later in the file (hand-edited, or a future format
  # change) must never be picked up by one side and not the other.
  local rotation=0 line value
  if [ -r "$DISPLAY_CONF" ]; then
    line="$(head -n1 "$DISPLAY_CONF" 2>/dev/null || true)"
    value="${line#ROTATION=}"
    case "$value" in
      0|90|180|270) rotation="$value" ;;
      *) rotation=0 ;;  # missing, malformed, or unreadable - default to normal
    esac
  fi

  # Normal orientation needs no transform call at all - also means a
  # missing/invalid config file is completely inert, not just "safe".
  [ "$rotation" != 0 ] || return 0

  if ! command -v wlr-randr >/dev/null 2>&1; then
    echo "lumina-kiosk: wlr-randr not installed, starting unrotated" >&2
    return 0
  fi

  # The compositor's output-management interface may not be ready the
  # instant cage starts, so retry briefly rather than giving up on one try.
  local output=""
  for _ in $(seq 1 5); do
    output="$(wlr-randr 2>/dev/null | awk '/^[^ \t]/ { print $1; exit }')"
    [ -n "$output" ] && break
    sleep 1
  done

  if [ -z "$output" ]; then
    echo "lumina-kiosk: no Wayland output detected, starting unrotated" >&2
    return 0
  fi

  if ! wlr-randr --output "$output" --transform "$rotation" >/dev/null 2>&1; then
    echo "lumina-kiosk: wlr-randr transform failed for output '$output', starting unrotated" >&2
  fi
}
apply_display_rotation

# --autoplay-policy is required for signage: without it Chromium blocks
# autoplay with sound, so video and YouTube items never start on their own.
exec "$BROWSER" \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=Translate \
  --disable-pinch \
  --no-first-run \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required \
  --user-data-dir="$PROFILE_DIR" \
  "${PLATFORM_ARGS[@]}" \
  "$BOOTSTRAP_URL"
